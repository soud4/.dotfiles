## ╔══════════════════════════════════════════════════════════════╗
## ║                    souda's nano · gruvbox                   ║
## ║                      minimal · useful                       ║
## ╚══════════════════════════════════════════════════════════════╝
## backup: ~/.nanorc.bak

## ── Comportamiento ─────────────────────────────────────────────
set autoindent              # indentación automática
set constantshow            # posición del cursor en minibar
set historylog              # recuerda búsquedas entre sesiones
set positionlog             # recuerda posición del cursor por archivo
set minibar                 # barra mínima (reemplaza titlebar)
set nohelp                  # oculta atajos inferiores
set stateflags              # I/M/L/R/S flags en minibar
set indicator               # scrollbar lateral sutil
set linenumbers             # números de línea
set softwrap                # wrap visual sin romper línea
set atblanks                # wrap en espacios, no a mitad de palabra
set smarthome               # Home inteligente (inicio de contenido)
set zap                     # Backspace/Delete borra selección
set multibuffer             # múltiples archivos en buffers separados
set mouse                   # soporte de mouse
set locking                 # lock-files para evitar conflictos
set noconvert               # no convertir formatos DOS/Mac
set trimblanks              # recorta espacios al final al guardar
set afterends               # Ctrl+Right para al final de palabra

## ── Tabulación ─────────────────────────────────────────────────
set tabsize 2
set tabstospaces

## ── Guía visual ────────────────────────────────────────────────
set guidestripe 80          # línea guía en columna 80

## ── Búsqueda ───────────────────────────────────────────────────
set regexp                  # búsqueda regex por defecto

## ── Syntax highlighting (ANTES de extendsyntax) ────────────────
include "/usr/share/nano/*.nanorc"
include "/usr/share/nano/extra/*.nanorc"

## ── Overrides por lenguaje ─────────────────────────────────────
extendsyntax makefile tabgives "	"
extendsyntax python tabgives "    "

## ── Gruvbox Dark ── colores nombrados ──────────────────────────
##
##  Aproximación Gruvbox con paleta nativa de nano:
##    bg0  → black         fg1    → white
##    bg1  → grey          yellow → yellow
##    gray → grey          aqua   → cyan
##    red  → red           green  → green
##    purple → magenta
##
set titlecolor      bold,white,grey
set promptcolor     white,grey
set statuscolor     bold,black,yellow
set errorcolor      bold,white,red
set spotlightcolor  black,yellow
set selectedcolor   white,grey
set stripecolor     ,grey
set scrollercolor   grey
set numbercolor     grey
set keycolor        yellow
set functioncolor   cyan
set minicolor       bold,white,grey

## ── Keybindings útiles ─────────────────────────────────────────

## Ctrl+S  → guardar directamente (sin prompt)
bind ^S savefile main

## Ctrl+Q  → salir
bind ^Q exit all

## Ctrl+Z  → undo
bind ^Z undo main

## Ctrl+Y  → redo
bind ^Y redo main

## Ctrl+Backspace → borrar palabra a la izquierda
bind ^H chopwordleft main

## Alt+K → comentar/descomentar línea
bind M-K comment main

## Ctrl+L → solo refrescar pantalla (no centrar cursor)
bind ^L refresh main

## Alt+/ → ir a línea
bind M-/ gotoline main

## Snip trailing whitespace al guardar (Alt+S)
bind M-S "{execute}| sed 's/\s\+$//' {enter}{savefile}" main
