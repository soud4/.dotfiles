# Swaylock Configuration
# Minimalist Gruvbox-inspired aesthetic

daemonize
ignore-empty-password

# Fondo de pantalla (Ruta ABSOLUTA requerida, no usar ~)
image=/home/souda/Documents/mountain-village.png
scaling=fill
color=060504

# Tipografía
font=Inter
font-size=18

# Dimensiones del indicador (compacto y sutil)
indicator-radius=45
indicator-thickness=4

# Ocultar el indicador cuando no se está escribiendo para una pantalla 100% limpia
# (Descomenta la siguiente línea si prefieres ver el círculo todo el tiempo):
# indicator-idle-visible

# Transparencias y separadores limpios
line-color=00000000
separator-color=00000000

# Estado normal / Escribiendo
inside-color=060504bb
ring-color=CB8F34aa
key-hl-color=59c2ffff
bs-hl-color=f07178ff
text-color=FAF4EBff

# Verificando contraseña (Verde sutil)
inside-ver-color=060504bb
ring-ver-color=aad94cff
text-ver-color=aad94cff

# Contraseña incorrecta (Rojo suave)
inside-wrong-color=060504bb
ring-wrong-color=f07178ff
text-wrong-color=f07178ff

# Borrado / Clear
inside-clear-color=060504bb
ring-clear-color=3a3a3aff
text-clear-color=FAF4EBff

# Distribución del teclado (Layout)
layout-text-color=FAF4EBff
layout-bg-color=060504bb
layout-border-color=00000000
