# ~/.config/zathura/zathurarc

# --- General ---------------------------------------------------------------
set selection-clipboard clipboard   # copiar al portapapeles del sistema
set adjust-open best-fit            # ajustar al abrir (o width)
set pages-per-row 1
set scroll-step 80
set zoom-step 10
set guioptions ""                   # oculta barra de estado (pon "s" para verla)
set recolor true                    # modo oscuro (alterna con la tecla i)
set recolor-keephue true            # conserva el tono de las imágenes
set database sqlite                 # recuerda la página donde quedaste

# --- Gruvbox dark ----------------------------------------------------------
set default-bg                "#282828"
set default-fg                "#ebdbb2"
set statusbar-bg              "#3c3836"
set statusbar-fg              "#ebdbb2"
set inputbar-bg               "#282828"
set inputbar-fg               "#ebdbb2"
set notification-bg           "#3c3836"
set notification-fg           "#ebdbb2"
set notification-error-bg     "#3c3836"
set notification-error-fg     "#fb4934"
set notification-warning-bg   "#3c3836"
set notification-warning-fg   "#fabd2f"
set completion-bg             "#3c3836"
set completion-fg             "#ebdbb2"
set completion-highlight-bg   "#504945"
set completion-highlight-fg   "#fabd2f"
set highlight-color           "rgba(250,189,47,0.4)"
set highlight-active-color    "rgba(254,128,25,0.5)"
set recolor-lightcolor        "#282828"
set recolor-darkcolor         "#ebdbb2"

# --- SyncTeX: Ctrl+clic en el PDF vuelve a Neovim --------------------------
set synctex true
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %{line}:%{column} '%{input}'\""

set font "MonaspiceNe NF 8"   # pon la misma fuente de tu terminal
set incremental-search true             # busca mientras escribes
set statusbar-basename true             # muestra solo el nombre del archivo, no la ruta
set window-title-basename true
set page-padding 4                      # espacio entre páginas
set scroll-page-aware true              # el scroll respeta los límites de página
set recolor-reverse-video true          # mejora el recolor en algunos PDFs


# --- Atajos ----------------------------------------------------------------
map r reload
map i recolor
map <C-d> scroll half-down
map <C-u> scroll half-up
map J navigate next
map K navigate previous
map <C-f> toggle_fullscreen
map <C-o> jumplist backward             # volver tras seguir un enlace o referencia
map <C-i> jumplist forward
map [fullscreen] <C-f> toggle_fullscreen
map D set "pages-per-row 2"             # vista de dos páginas
map S set "pages-per-row 1"
