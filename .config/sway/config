# ╔══════════════════════════════════════════════════════════════════╗
# ║                    SWAY WINDOW MANAGER CONFIG                    ║
# ║                  Referencia: man 5 sway                          ║
# ╚══════════════════════════════════════════════════════════════════╝


###############################################################################
# VARIABLES
###############################################################################

# Tecla modificadora principal (Mod4 = Super/Win | Mod1 = Alt)
set $mod Mod4

# Teclas de dirección estilo Vim
set $left  h
set $down  j
set $up    k
set $right l

# Terminal preferida
set $term foot


###############################################################################
# FUENTE
###############################################################################

font pango:Inter ExtraBold 8

###############################################################################
# APARIENCIA DE VENTANAS
###############################################################################

# Borde de 1px sin barra de título para ventanas normales y flotantes
default_border          pixel 1
default_floating_border pixel 1

# Padding interno del titlebar: horizontal x vertical
titlebar_padding 1 1

###############################################################################
# INPUT — TECLADO
###############################################################################

# Activar numlock al iniciar sesión
input type:keyboard xkb_numlock enabled

input type:keyboard {
    xkb_layout latam
    xkb_model  pc105
    repeat_delay 300
    repeat_rate  40
}


###############################################################################
# INPUT — TOUCHPAD
###############################################################################

set $touchpad 1267:12871:ELAN06FA:00_04F3:3247_Touchpad

input $touchpad {
    # Tap con uno/dos/tres dedos
    tap       enabled
    drag      enabled
    drag_lock disabled

    natural_scroll enabled

    dwt  enabled
    dwtp enabled

    accel_profile flat
    pointer_accel -0.1

    click_method   clickfinger
    tap_button_map lrm

    scroll_method two_finger

    # Estado inicial
    events disabled_on_external_mouse
}

###############################################################################
# ASIENTO (SEAT)
###############################################################################

seat seat0 {
    # Ocultar cursor del mouse tras 3 segundos de inactividad
    hide_cursor 3000
}


###############################################################################
# ATAJOS — BÁSICOS
###############################################################################

# Abrir terminal
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot --title scratch-terminal



# Cerrar ventana enfocada
bindsym $mod+Shift+q kill

# Arrastrar ventanas flotantes: $mod + clic izq
# Redimensionar ventanas flotantes: $mod + clic der
floating_modifier $mod normal

# Recargar el config de sway sin reiniciar la sesión
bindsym $mod+Shift+c reload

# Salir de sway (cierra la sesión Wayland)
bindsym $mod+Shift+e exec swaynag -t warning \
    -m '¿Salir de Sway? Esto cerrará tu sesión Wayland.' \
    -B 'Sí, salir' 'swaymsg exit'


###############################################################################
# ATAJOS — APLICACIONES
###############################################################################

set $browser /usr/bin/librewolf



# Definir wmenu con estilo personalizado
set $menubin wmenu-run -i \
    -f "Inter ExtraBold 8" \
    -p " RUN " \
    -N 1d2021 -n ebdbb2 \
    -M 3c3836 -m fabd2f \
    -S 504945 -s fbf1c7

set $menuapp wmenu-drun


bindsym $mod+d          exec $menuapp
bindsym $mod+Shift+p    exec $menubin
bindsym $mod+Shift+b    exec $browser


# Scratchpad terminal: toggle mostrar/ocultar con $mod+` (tecla grave/tilde)
# Se inicia automáticamente al arrancar sway (ver sección AUTOSTART)
bindsym $mod+grave [title="scratch-terminal"] scratchpad show



###############################################################################
# ATAJOS — FOCO DE VENTANAS
###############################################################################

# Mover foco — teclas Vim
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# Mover foco — teclas de dirección
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Ciclar al siguiente contenedor en el workspace actual
bindsym $mod+Tab focus next

# Subir foco al contenedor padre
bindsym $mod+a focus parent

# Alternar foco entre área de tiling y área flotante
bindsym $mod+space focus mode_toggle


###############################################################################
# ATAJOS — MOVER VENTANAS
###############################################################################

# Mover ventana — teclas Vim
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# Mover ventana — teclas de dirección
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right


###############################################################################
# ATAJOS — WORKSPACES
###############################################################################

# Ir al workspace N
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Mover ventana al workspace N (y seguirla con $mod+Shift+Tab para volver)
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Navegar entre workspaces adyacentes
bindsym $mod+Shift+Tab    workspace prev
bindsym $mod+bracketleft  workspace prev
bindsym $mod+bracketright workspace next


###############################################################################
# ATAJOS — LAYOUT
###############################################################################

# Dividir el contenedor actual: horizontal ($mod+b) o vertical ($mod+v)
bindsym $mod+b splith
bindsym $mod+v splitv

# Cambiar estilo de layout del workspace
bindsym $mod+s layout stacking   # ventanas apiladas con lista de títulos
bindsym $mod+w layout tabbed     # ventanas en pestañas
bindsym $mod+e layout toggle split  # alternar split h/v

# Pantalla completa para la ventana enfocada
bindsym $mod+f fullscreen

# Alternar entre flotante y tiling
bindsym $mod+Shift+space floating toggle


###############################################################################
# SCRATCHPAD
###############################################################################

# El scratchpad es una "bolsa de holding": ventanas invisibles disponibles
# en cualquier workspace. Útil para terminales, música, herramientas, etc.

# Enviar ventana enfocada al scratchpad
bindsym $mod+minus move scratchpad

# Mostrar/ocultar el scratchpad (cicla si hay varias ventanas)
bindsym $mod+Shift+minus scratchpad show


###############################################################################
# MODO RESIZE
###############################################################################

mode "resize" {
    # Redimensionar con teclas Vim
    bindsym $left  resize shrink width  10px
    bindsym $down  resize grow   height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow   width  10px

    # Redimensionar con teclas de dirección
    bindsym Left  resize shrink width  10px
    bindsym Down  resize grow   height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow   width  10px

    # Salir del modo resize
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"


###############################################################################
# TECLAS MULTIMEDIA
# --locked = funcionan incluso con pantalla bloqueada
###############################################################################

# Volumen del sistema
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute        exec pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brillo de pantalla (requiere brightnessctl)
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+

# Control de reproducción multimedia (requiere playerctl)
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioPrev  exec playerctl previous
bindsym --locked XF86AudioStop  exec playerctl stop


###############################################################################
# CAPTURAS DE PANTALLA
# Requiere: grim, slurp, wl-copy, imagemagick
###############################################################################

# Print                → Captura la pantalla completa al portapapeles
# $mod+Print           → Captura una región seleccionada al portapapeles
# $mod+Shift+Print     → Captura el color de un píxel (eyedropper) al portapapeles

bindsym Print exec \
    grim - | wl-copy

bindsym $mod+Print exec \
    grim -g "$(slurp)" - | wl-copy

bindsym $mod+Shift+Print exec \
    grim -g "$(slurp -p)" -t ppm - \
    | convert - -format "%[pixel:p{0,0}]" txt:- \
    | tail -n 1 | cut -d " " -f 4 | wl-copy


###############################################################################
# REGLAS DE VENTANAS (for_window)
###############################################################################

# --- Flotantes por tipo/rol XDG estándar ---
for_window [window_role="pop-up"]  floating enable
for_window [window_role="dialog"]  floating enable
for_window [window_type="dialog"]  floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"]  floating enable

# --- Picture-in-Picture (YouTube, Firefox, Librewolf) ---
for_window [title="^Picture in picture$"] floating enable, sticky enable, border pixel 1
for_window [title="Picture-in-Picture"]   floating enable, sticky enable, border pixel 1
no_focus [title="^Picture in picture$"]
no_focus [title="Picture-in-Picture"]

# --- Visores de imágenes y video ---
for_window [app_id="imv"] floating enable
for_window [app_id="mpv"] floating enable

# --- Diálogos de archivo (abrir/guardar) ---
for_window [title="Open File"] floating enable
for_window [title="Save File"] floating enable

# Centrar todas las ventanas flotantes automáticamente
for_window [floating] move position center

# --- Reubicar el PiP a una esquina DESPUÉS de la regla genérica de centrado ---
for_window [title="^Picture in picture$"] move position 1500 850
for_window [title="Picture-in-Picture"]   move position 1500 850


# --- Librewolf ---
# Ocultar título de pestaña (no muestra la URL en la barra de título)
for_window [app_id="librewolf"] title_format "Librewolf"
# Reducir saturación de color — 0=gris total, 10=normal; ajusta a tu gusto
for_window [app_id="librewolf"] saturation set 5

# --- Terminal scratchpad ---
# Se crea al iniciar sway (ver AUTOSTART), aquí se configura su aspecto
for_window [title="scratch-terminal"] {
    floating enable
    border pixel 2
    resize set width 90 ppt height 80 ppt
    move position center
    move scratchpad
}

###############################################################################
# AUTOSTART
###############################################################################

output * bg ~/.config/sway/wall.jpg fill

output eDP-1 position 0,0
output HDMI-A-1 position 1920,0


exec {
    # Fuente y tema GTK para apps Qt/GTK bajo Wayland
    gsettings set org.gnome.desktop.interface font-name             "Inter 9"
    gsettings set org.gnome.desktop.interface cursor-size           '24'
    gsettings set org.gnome.desktop.interface gtk-theme             'Gruvbox-BL-MB-Dark-Medium'
    gsettings set org.gnome.desktop.interface font-antialiasing     'rgba'
    gsettings set org.gnome.desktop.interface font-hinting          'full'
    gsettings set org.gtk.Settings.FileChooser window-size          '(1000, 500)'
    gsettings set org.gnome.desktop.interface.wm.preferences theme  'Adwaita-dark'
    gsettings set org.gnome.desktop.interface icon-theme            'Adwaita'
    gsettings set org.gnome.desktop.interface cursor-theme          'phinger-cursors-dark'
    gsettings set org.gnome.desktop.interface cursor-size           24

    # Lanzar la terminal de scratchpad en segundo plano
    # ($mod+` para mostrarla / ocultarla desde cualquier workspace)
    foot --title scratch-terminal
}

seat seat0 xcursor_theme phinger-cursors-dark 24


###############################################################################
# INCLUDES
###############################################################################

# Cargar configuraciones adicionales del sistema (waybar, etc.)
include config.d/*


bar {
    status_command i3status-rs
    position bottom
    mode dock

    # Tipografía moderna para la barra
    font pango:Inter ExtraBold 8

    # Separador estilizado
    # separator_symbol " | "

    colors {
        # Fondo y texto general de la barra
        background         $bg0
        statusline         $fg1
        separator          $bg3

        # Workspaces:          borde     fondo     texto
        focused_workspace      $borange  $borange  $bg0
        active_workspace       $bg2      $bg2      $fg1
        inactive_workspace     $bg0      $bg0      $fg4
        urgent_workspace       $bred     $bred     $fg0
        binding_mode           $bred     $bred     $fg0
    }
}
