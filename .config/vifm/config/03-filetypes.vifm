" =============================================================================
" 03-filetypes.vifm -- what Enter/l opens, per file type
" =============================================================================
"
" The stock sample config shipped dozens of associations for programs that are
" not installed here (sxiv, gpicview, mplayer, ffplay, links, qutebrowser,
" Thunar, ktorrent, catdoc...), which filled the open-with menu with entries
" that simply fail. Everything below is guarded by executable() so the menu
" only ever lists programs that exist, and xdg-open is registered last as a
" universal fallback.
"
" :filetype  = console program (runs inside the terminal)
" :filextype = graphical program (used when a GUI session is available)

" ------------------------------------------------------------------- images
if executable('imv')
    filextype {*.png,*.jpg,*.jpeg,*.gif,*.webp,*.bmp,*.avif,*.ico,*.tif,
              \*.tiff,*.xpm,*.ppm,*.heic},
             \<image/*>
            \ {View in imv}
            \ imv %f &,
endif
if executable('inkscape')
    filextype {*.svg,*.svgz},<image/svg+xml> {Edit in Inkscape} inkscape %f &,
endif
if executable('gimp')
    filextype {*.xcf,*.png,*.jpg,*.jpeg},<image/*> {Edit in GIMP} gimp %f &,
endif

" -------------------------------------------------------------------- video
if executable('mpv')
    filextype {*.mp4,*.mkv,*.webm,*.avi,*.mov,*.m4v,*.flv,*.wmv,*.mpg,
              \*.mpeg,*.ogv,*.3gp,*.ts,*.vob,*.m2v,*.divx},
             \<video/*>
            \ {Play in mpv}
            \ mpv --quiet %f &,
            \ {Play in mpv (terminal)}
            \ mpv %f,
endif

" -------------------------------------------------------------------- audio
if executable('mpv')
    filetype {*.mp3,*.flac,*.opus,*.ogg,*.oga,*.wav,*.m4a,*.aac,*.wma,
             \*.ape,*.mid},
            \<audio/*>
           \ {Play in mpv}
           \ mpv --no-video %f,
endif

" ---------------------------------------------------------------------- PDF
" zathura is not installed at the moment; xdg-open covers it either way.
if executable('zathura')
    filextype {*.pdf},<application/pdf> {View in zathura} zathura %f &,
endif
filextype {*.pdf,*.ps,*.eps,*.djvu},
         \<application/pdf,application/postscript>
        \ {Open with default viewer}
        \ xdg-open %f &,

" ------------------------------------------------------- text, code, configs
" Anything textual goes to the editor. 'vicmd' is nvim (see 01-options.vifm),
" so :edit / e handles these too; this makes Enter do the same thing.
filetype {*.md,*.markdown,*.rst,*.org,*.txt,*.log,*.json,*.yml,*.yaml,
         \*.toml,*.ini,*.conf,*.cfg,*.rs,*.py,*.js,*.ts,*.jsx,*.tsx,*.go,
         \*.lua,*.c,*.h,*.cc,*.cpp,*.hpp,*.sh,*.bash,*.zsh,*.fish,*.vim,
         \*.vifm,*.nix,*.rb,*.pl,*.php,*.java,*.kt,*.hs,*.sql,*.csv,*.tsv,
         \*.diff,*.patch,*.desktop,*.service},
        \<text/*>
       \ {Edit}
       \ nvim %f,

" --------------------------------------------------------------------- HTML
filextype {*.html,*.htm,*.xhtml},<text/html>
        \ {Open in browser}
        \ xdg-open %f &,
filetype {*.html,*.htm,*.xhtml},<text/html> {Edit} nvim %f,

" ----------------------------------------------------------------- documents
if executable('libreoffice')
    filextype {*.odt,*.ods,*.odp,*.doc,*.docx,*.xls,*.xlsx,*.ppt,*.pptx,
              \*.rtf},
             \<application/vnd.openxmlformats-officedocument.*,
              \application/msword,application/vnd.ms-excel>
            \ {Open in LibreOffice}
            \ libreoffice %f &,
endif

" ------------------------------------------------------------------ archives
" atool is a single front-end for zip/tar/7z/rar/..., which replaces the
" per-format rules of the sample config.
if executable('atool')
    filetype {*.zip,*.jar,*.war,*.ear,*.oxt,*.tar,*.tar.gz,*.tgz,*.tar.bz2,
             \*.tbz2,*.tar.xz,*.txz,*.tar.zst,*.tzst,*.7z,*.rar,*.gz,*.bz2,
             \*.xz,*.zst,*.lz4,*.lzma,*.cpio,*.rpm,*.deb},
            \<application/zip,application/x-tar,application/x-7z-compressed,
             \application/x-rar,application/gzip,application/x-xz,
             \application/zstd,application/java-archive>
           \ {Extract here}
           \ atool -x %f,
           \ {Extract into its own directory}
           \ atool -X . %f,
           \ {List contents}
           \ atool -l %f | less,
endif

" Read-only FUSE mounts: browse an archive as if it were a directory.
if executable('fuse-zip')
    filetype {*.zip,*.jar,*.war,*.ear,*.oxt},
            \<application/zip,application/java-archive>
           \ {Mount with fuse-zip}
           \ FUSE_MOUNT|fuse-zip %SOURCE_FILE %DESTINATION_DIR,
endif
if executable('archivemount')
    filetype {*.tar,*.tar.gz,*.tgz,*.tar.bz2,*.tbz2,*.tar.xz,*.txz,
             \*.tar.zst,*.tzst},
            \<application/x-tar>
           \ {Mount with archivemount}
           \ FUSE_MOUNT|archivemount %SOURCE_FILE %DESTINATION_DIR,
endif
if executable('fuseiso')
    filetype {*.iso},<application/x-iso9660-image>
           \ {Mount with fuseiso}
           \ FUSE_MOUNT|fuseiso %SOURCE_FILE %DESTINATION_DIR,
endif

" --------------------------------------------------------- remote filesystems
" A plain-text *.ssh / *.ftp file holding connection parameters gets mounted.
if executable('sshfs')
    filetype *.ssh
           \ {Mount with sshfs}
           \ FUSE_MOUNT2|sshfs %PARAM %DESTINATION_DIR %FOREGROUND,
endif
if executable('curlftpfs')
    filetype *.ftp
           \ {Mount with curlftpfs}
           \ FUSE_MOUNT2|curlftpfs -o ftp_port=-,,disable_eprt %PARAM %DESTINATION_DIR %FOREGROUND,
endif

" ------------------------------------------------------- integrity and crypto
filetype *.md5    {Check MD5}    md5sum -c %f %S,
filetype *.sha1   {Check SHA1}   sha1sum -c %f %S,
filetype *.sha256 {Check SHA256} sha256sum -c %f %S,
filetype *.sha512 {Check SHA512} sha512sum -c %f %S,
if executable('gpg')
    filetype {*.asc},<application/pgp-signature>
           \ {Verify signature}
           \ !!gpg --verify %c,
endif

" ------------------------------------------------------------------ packages
filetype {*.deb},<application/vnd.debian.binary-package>
       \ {Inspect}
       \ !!sh -c 'dpkg-deb -I %c; echo; dpkg-deb -c %c' | less,

" ---------------------------------------------------------------- man  pages
filetype {*.[1-8]},<text/troff> {Read manual} man ./%c,

" ------------------------------------------------------------------ fallback
" Registered last, so it shows up as the final choice in the open-with menu
" for everything above and as the only choice for anything not listed.
filextype * {Open with system default} xdg-open %f &,
