# ~/.config/mako/config
# Configuración de Mako con el tema Gruvbox Dark
# Última actualización: 2026-10-04

# =============================================
#  ESTILOS GLOBALES (para notificaciones normales)
# =============================================
background-color=#282828
text-color=#ebdbb2
border-color=#fe8019
border-size=2
border-radius=0
font=Inter 10
width=350
default-timeout=5000
ignore-timeout=1
max-visible=5
anchor=top-right
margin=40,20
padding=12

# Formato para el título (opcional, pero útil)
# format=<b>%s</b>\n%b
# format=<b>%s</b>\n%b\n<span size="small" alpha="50%">%a</span>

# =============================================
#  ESTILOS POR URGENCIA
# =============================================

# Notificaciones de baja urgencia (ej: actualizaciones menores)
[urgency=low]
border-color=#83a598
default-timeout=3000

# Notificaciones normales (por defecto, se usa lo global)
# [urgency=normal]
# background-color=#282828
# border-color=#504945

# Notificaciones críticas (ej: errores del sistema, batería baja)
[urgency=critical]
background-color=#3c3836
border-color=#fb4934
border-size=0
default-timeout=0
